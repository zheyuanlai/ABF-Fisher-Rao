#!/bin/bash
# CPU-only task (analysis, MBAR merge).  qsub -P personal-e1297740 -v TASK=... scripts/deca_fr_2026/pbs/cpu_task.pbs
#PBS -N deca_fr_cpu
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=100gb
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o /scratch/users/nus/e1297740/logs/
set -uo pipefail
: "${TASK:?pass TASK via qsub -v}"
source /scratch/users/nus/e1297740/ABF-Fisher-Rao/scripts/deca_fr_2026/env.sh
export OMP_NUM_THREADS=16 OPENBLAS_NUM_THREADS=16 MKL_NUM_THREADS=16
JOB=${PBS_JOBID%%.*}
LOG=$DF_LOGS/$(basename "$TASK" .sh)_${JOB}.log
echo "job $PBS_JOBID task $TASK host $(hostname) start $(date -u +%FT%TZ) commit $(git -C $DF_ROOT rev-parse --short HEAD)" | tee "$LOG"
CUDA_VISIBLE_DEVICES="" bash "$TASK" 2>&1 | tee -a "$LOG"
rc=${PIPESTATUS[0]}
echo "TASK_EXIT $rc $(date -u +%FT%TZ)" | tee -a "$LOG"
exit $rc
