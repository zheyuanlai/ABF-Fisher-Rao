__pycache__/
*.pyc
.pytest_cache/
results/**/*.npy
results/**/*.npz
# the confirmation curve archives are small (~1.5 MB total) and figures/make_figures.py
# needs them to redraw the convergence panels from stored results
!results/confirm/*_curves.npz
# molecular phase: the reference profiles and the confirmation/sweep archives are
# what figures/make_mol_figures.py redraws from.  The configuration LIBRARIES
# (*_conflib.npz, 30-80 MB) are regenerable by scripts/mol_conf_library.py and
# are not tracked.
!results/mol/ref/*_ref.npz
!results/mol/ref/*_tiref.npz
!results/mol/ref_cond/*_tiref.npz
!results/mol/campaign/*_confirm.npz
!results/mol/campaign/*_kappa.npz
!results/mol/campaign/*_hex*.npz
!results/mol/*_fiber_time.npz
results/mol/ref/*_conflib.npz
*.egg-info/
.ipynb_checkpoints/
